# ============================================================================
#  SETTINGS  -  models, voices, timings. NO secrets here (those stay in .env).
#  Same KEY=value format as .env. Restart the agent after changing anything.
#  Priority: shell variable > this file > .env
#
#  Changing a MODEL below? The price calculator reads the model names from this
#  file. A model with no price in prices.ini shows as UNPRICED, and
#  price_check.py (run automatically at startup) asks you for the price.
# ============================================================================

# ---------- MODELS (priced in prices.ini) ----------------------------------
# LLM (Groq). Qwen 3.8 27B is a Groq "preview" model and can be withdrawn at short notice.
# llama-3.1-8b-instant and llama-3.3-70b-versatile were shut down for free/developer tiers on 2026-08-16.
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low        # gpt-oss: low | medium | high. (Qwen always runs with reasoning off.)
MAX_REPLY_TOKENS=300

# TTS (Sarvam)
TTS_MODEL=bulbul:v4-flash

# STT: pick ONE provider. Each provider has its own model line, so switching is a one-word change.
#   sarvam      Hindi/Punjabi/Indian English, the baseline
#   soniox      key SONIOX_API_KEY in .env
#   elevenlabs  key ELEVEN_API_KEY in .env (Scribe v2 Realtime)
STT_PROVIDER=elevenlabs
SARVAM_STT_MODEL=saaras:v3-realtime     # or saaras:v4
SONIOX_STT_MODEL=stt-rt-v5              # v5 supports the two endpoint_* knobs below; older models reject them
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# The model of the chosen provider is what the price calculator looks up (prices.ini [stt:<model>]).

# ---------- STT behaviour: Soniox -------------------------------------------
SONIOX_LANGUAGE_HINTS=hi,pa,en   # hints, not limits (set SONIOX_HINTS_STRICT=1 to restrict)
SONIOX_ENDPOINT_MS=700           # max wait after you stop talking before the turn ends (500..3000). Lower = faster, may cut you off
SONIOX_ENDPOINT_SENSITIVITY=     # v5 only, -1..1. Higher = ends turns sooner. Empty = server default
SONIOX_ENDPOINT_LATENCY_LEVEL=   # v5 only, 0..3. Higher = lower latency, slightly less accuracy. Empty = server default
# SONIOX_CONTEXT=Anima, Jarvis      # free text: names and terms to recognise better

# ---------- STT behaviour: ElevenLabs ---------------------------------------
# ELEVEN_LANGUAGE=hi             # empty = auto-detect
# ELEVEN_VAD_SILENCE_S=0.6

# ---------- STT behaviour: Sarvam -------------------------------------------
# auto = detect the language every turn. If you always speak one language, set a fixed code (hi-IN, pa-IN, en-IN).
SARVAM_RT_LANGUAGE=auto
SARVAM_RT_STREAM_TYPE=fast       # fast | balanced
SARVAM_VAD_SILENCE_MS=300

# ---------- STT behaviour: all providers ------------------------------------
ENDPOINT_MIN_DELAY_S=0.25
FILLER_DELAY_S=0.3
START_LANG=hi                    # voice used until the first reply: hi, pa or en

# ---------- Voices (Bulbul v4-flash) ---------------------------------------
SPEAKER_HI=aparna_hi_customer
SPEAKER_EN=simran_en_customer
SPEAKER_PA=anand_pa_customer

# ---------- Web search ------------------------------------------------------
# Tavily and Exa are used when their keys are in .env.
TAVILY_DEPTH=ultra-fast          # ultra-fast | fast | basic

# ---------- Wake word (openWakeWord) ----------------------------------------
# The agent sleeps until it hears the wake word. While asleep NO audio goes to STT.
# After a reply it keeps listening WAKE_IDLE_S seconds, then sleeps again.
WAKE_ENABLED=1                   # 0 = always listening, like before
WAKE_NAME=Anima                  # the name the model is told it has
WAKE_MODEL=hey_jarvis            # TESTING: a pretrained model. Once trained, set:  WAKE_MODEL=anima.onnx
WAKE_THRESHOLD=0.5               # higher = fewer false wakes, more misses. Tune with: python test_wakeword.py
WAKE_HITS=2                      # consecutive 80 ms chunks above the threshold needed
WAKE_IDLE_S=5                    # listening window after a reply
WAKE_GRACE_S=8                   # wait for a question after the wake word, then sleep
WAKE_PREROLL_S=1.2               # audio before the detection that is replayed into STT

# STT is switched OFF while the agent thinks/speaks (nothing billed, it cannot hear itself).
# Voice barge-in is replaced by a STOP word: say it and the reply is cut, STT turns back on.
STT_MUTE_WHILE_REPLYING=1        # 0 = STT stays on during replies (old behaviour, normal barge-in)
STOP_MODEL=                      # TESTING: empty = same model as WAKE_MODEL (so "hey jarvis" stops it). Later: stop.onnx
STOP_THRESHOLD=                  # empty = WAKE_THRESHOLD
STOP_HITS=                       # empty = WAKE_HITS

ELEVEN_VAD_SILENCE_S=0.4
# ---------- Logs and prices -------------------------------------------------
# LOG_FILE=agent.log
# PRICES_FILE=prices.ini
# ASK_PRICES=0                   # 0 = never ask for prices at startup, only warn

# Anything else listed in the header of Structure-II.py (SEARCH_TIMEOUT_S, ECHO_GUARD, LOCAL_VAD, ...)
# can be added here too, one per line.
